#!name=walter个人配置
#!desc=个人直连规则；北外滩签7天停1天；九号、百联、万象、龙湖、网上国网每日11:00–12:00随机签到。

# 启用前请停用原来的同名模块、独立签到任务和Token提取任务，避免重复运行。
# 需开启HTTPS解密，并安装、信任Shadowrocket当前使用的证书。
# Token和签到状态只保存在手机本地，不包含在仓库中。

[Rule]
DOMAIN-SUFFIX,03061026.xyz,DIRECT
DOMAIN,emby.barrybarry.top,DIRECT
DOMAIN,csc-service.sgcc.com.cn,DIRECT

[Script]
国客Token提取 = type=http-request,pattern=^https://m\.mallcoo\.cn/api/,script-path=https://raw.githubusercontent.com/lh0410/shadowrocket-config/main/scripts/beiwaitan-token.js,requires-body=true,binary-body-mode=false,max-size=131072,engine=jsc,timeout=10,enable=true
国客每日签到 = type=cron,cronexp="*/5 11 * * *",script-path=https://raw.githubusercontent.com/lh0410/shadowrocket-config/main/scripts/beiwaitan-signin.js?v=20261117-cycle,engine=jsc,timeout=60,enable=true
九号参数提取 = type=http-request,pattern=^https://cn-cbu-gateway\.ninebot\.com/portal/api/user-sign/v2/(status|sign)(\?|$),script-path=https://raw.githubusercontent.com/lh0410/shadowrocket-config/main/scripts/ninebot-token.js,requires-body=true,binary-body-mode=false,max-size=131072,engine=jsc,timeout=10,enable=true
九号每日签到 = type=cron,cronexp="* 11 * * *",script-path=https://raw.githubusercontent.com/lh0410/shadowrocket-config/main/scripts/ninebot-signin.js,engine=jsc,timeout=60,enable=true
百联参数提取 = type=http-request,pattern=^https://mh5\.bl\.com/h5_gateway/,script-path=https://raw.githubusercontent.com/lh0410/shadowrocket-config/main/scripts/mall-token.js?v=20261117-malls,requires-body=false,engine=jsc,timeout=10,enable=true
万象参数提取 = type=http-request,pattern=^https://app\.mixcapp\.com/mixc/(gateway|api/v4/member/getPersonalData)(\?|$),script-path=https://raw.githubusercontent.com/lh0410/shadowrocket-config/main/scripts/mall-token.js?v=20261117-malls,requires-body=true,binary-body-mode=false,max-size=131072,engine=jsc,timeout=10,enable=true
龙湖参数提取 = type=http-request,pattern=^https://gw2c-hw-open\.longfor\.com/lmarketing-task-api-mvc-prod/openapi/task/v1/signature/(page-info|clock)(\?|$),script-path=https://raw.githubusercontent.com/lh0410/shadowrocket-config/main/scripts/mall-token.js?v=20261117-malls,requires-body=true,binary-body-mode=false,max-size=131072,engine=jsc,timeout=10,enable=true
百联万象龙湖签到 = type=cron,cronexp="* 11 * * *",script-path=https://raw.githubusercontent.com/lh0410/shadowrocket-config/main/scripts/mall-signin.js?v=20261117-malls,engine=jsc,timeout=60,enable=true
网上国网每日签到 = type=cron,cronexp="* 11 * * *",script-path=https://raw.githubusercontent.com/lh0410/shadowrocket-config/main/scripts/sgcc-signin.js?v=20261117-sgcc,engine=jsc,timeout=60,enable=true

[MITM]
hostname = %APPEND% m.mallcoo.cn, cn-cbu-gateway.ninebot.com, mh5.bl.com, app.mixcapp.com, gw2c-hw-open.longfor.com
